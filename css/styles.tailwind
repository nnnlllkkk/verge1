@tailwind base;
@tailwind components;
@tailwind utilities;

@keyframes fadeInPage {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
}

::-webkit-scrollbar { 
    width: 8px; 
    height: 8px; 
}
::-webkit-scrollbar-track { 
    background: #121212; 
}
::-webkit-scrollbar-thumb { 
    background: #333; 
    border-radius: 4px; 
}
::-webkit-scrollbar-thumb:hover { 
    background: #ccff00; 
}


